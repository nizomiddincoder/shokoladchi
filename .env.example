# ===== ASOSIY =====
# PostgreSQL ulanish URL i (Railway > Postgres > Connect > Database URL)
DATABASE_URL=

# HTTP port (Railway o'zi beradi, lokalda 3000)
PORT=3000

# JWT imzo kaliti (uzun tasodifiy satr; bo'sh bo'lsa bazada generatsiya bo'ladi)
JWT_SECRET=

# ===== TELEGRAM =====
# @BotFather dan olingan bot tokeni
BOT_TOKEN=
# Railway domeni (https://...) — Mini App tugmasi shu manzilga /mini/ ochiladi
APP_URL=
# Kassa guruhining chat ID si (botga /id yozib olingan) — yangi buyurtma/savdo xabarlari
GROUP_CHAT_ID=
# Admin shaxsiy chat ID si — kunlik hisobot va ogohlantirishlar
ADMIN_CHAT_ID=

# ===== EMAIL (ixtiyoriy) =====
# Masalan: smtps://user:pass@smtp.gmail.com:465
SMTP_URL=
SMTP_FROM=

# ===== RASM ISHLOVI (ixtiyoriy — AI fon olib tashlash) =====
# google | (bo'sh = AI ishlovi o'chiq, asl rasm saqlanadi)
IMG_PROVIDER=
IMG_API_KEY=
IMG_MODEL=gemini-2.0-flash-preview-image-generation

# ===== TO'LOV WEBHOOK KALITLARI (ixtiyoriy) =====
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_KEY=

# ===== BOSHQALAR =====
AGENT_TOKEN=savdo-agent-token
FISCAL_API_URL=
